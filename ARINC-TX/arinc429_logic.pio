.program arinc429_logic_tx

.define public HALF_CYCLES 5
.define public WORD_GAP_HALVES 8

; Recreacion logica/temporal de ARINC 429:
; - HI  = 10
; - LO  = 01
; - NULL= 00
;
; Cada bit se transmite como RZ bipolar logico:
; - primera mitad: HI o LO
; - segunda mitad: NULL
;
; Temporizacion:
; - la mitad activa ocupa HALF_CYCLES ciclos en el set pins activo
; - la mitad NULL ocupa set pins,0 + instrucciones de control
; Esto evita sumar out/jmp por fuera del calculo del bit time.
;
; La palabra completa sigue saliendo LSB-first, y el label ya debe venir
; preadaptado desde C con arinc429_label_to_wire().

.wrap_target
word_start:
    pull block
    set y, 31

bitloop:
    out x, 1
    jmp !x send_lo

send_hi:
    set pins, 2        [HALF_CYCLES - 1]
    set pins, 0
    jmp bit_done

send_lo:
    set pins, 1        [HALF_CYCLES - 1]
    set pins, 0
    nop

bit_done:
    jmp y-- bitloop

gap_setup:
    set x, 7

gap_loop:
    nop               [HALF_CYCLES - 2]
    jmp x-- gap_loop
.wrap


.program arinc429_logic_rx

; RX logico de ARINC 429:
; - espera actividad en cualquiera de los dos hilos
; - clasifica HI / LO usando pin_base+1
; - exige retorno a NULL antes de cerrar el simbolo
; - reconstruye 32 bits y empuja la palabra

.wrap_target
word_start:
    mov isr, null
    set x, 31

wait_active:
    mov y, pins
    jmp !y wait_active
    jmp pin bit_hi

bit_lo:
    set y, 0
    in y, 1
    jmp wait_null

bit_hi:
    set y, 1
    in y, 1

wait_null:
    mov y, pins
    jmp !y bit_done
    jmp wait_null

bit_done:
    jmp x-- wait_active
    push block
.wrap
