.program mil1553_rx

; ============================================================
; Clasificador inicial de sincronismo MIL-STD-1553
;
; MISMO programa para dos State Machines:
;
; SM0:
;   pin 0    = GP2 / P
;   JMP PIN  = GP2 / P
;   FIFO     = CMD/STATUS
;
; SM1:
;   pin 0    = GP3 / N
;   JMP PIN  = GP3 / N
;   FIFO     = DATA WORD
;
; La primera línea que sube después del reposo gana.
;
; IRQ 0 actúa como lock entre ambas SM.
;
; Todavía NO validamos los 3 us completos del sincronismo.
; ============================================================

.wrap_target


wait_start:

    ; La línea propia debe estar LOW.
    wait 0 pin 0

    ; Esperar su flanco ascendente.
    wait 1 pin 0


    ; --------------------------------------------------------
    ; Esperar que el clasificador esté libre.
    ;
    ; La SM correspondiente a la primera mitad del sync
    ; llegará acá antes que la otra.
    ; --------------------------------------------------------

    wait 0 irq 0


    ; --------------------------------------------------------
    ; IMPORTANTE:
    ;
    ; Si estuvimos bloqueados esperando que la otra SM
    ; terminara, este flanco puede pertenecer a la segunda
    ; mitad del mismo sync.
    ;
    ; Por eso comprobamos que nuestra línea SIGA HIGH.
    ; --------------------------------------------------------

    jmp pin claim

    ; Ya volvió a LOW -> candidato viejo.
    jmp wait_start



claim:

    ; Bloquear a la otra State Machine.
    irq set 0


    ; --------------------------------------------------------
    ; Entregar un evento a la FIFO propia.
    ;
    ; Ambas SM escriben 1.
    ;
    ; El Cortex determina el tipo según la FIFO:
    ;
    ; SM0 FIFO -> CMD/STATUS
    ; SM1 FIFO -> DATA
    ; --------------------------------------------------------

    set x, 1
    mov isr, x
    push block


    ; --------------------------------------------------------
    ; LOCK TEMPORAL
    ;
    ; Esperamos ~25 us, más que la palabra completa (~20 us).
    ;
    ; Y=5 -> seis iteraciones.
    ;
    ; 6 * 33 ciclos ~= 198 ciclos
    ; 198 * 125 ns ~= 24.75 us
    ;
    ; Así la segunda mitad del sync y los bits Manchester
    ; quedan completamente ignorados.
    ; --------------------------------------------------------

    set y, 5


hold_bus:

    nop [31]
    jmp y-- hold_bus


    ; La palabra ya terminó.
    irq clear 0

    jmp wait_start


.wrap