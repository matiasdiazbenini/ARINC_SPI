
.program mil1553_rx

.wrap_target

public cmd_entry:

acquisition:
    wait 0 pin 0

tracking:
    wait 1 pin 0

sync_high_begin:
    set y, 2

sync_high_check:
    jmp pin sync_high_still
    jmp acquisition

sync_high_still:
    jmp y-- sync_high_check [1]

    wait 0 pin 0

    set x, 16 [3]

    jmp pin acquisition

    nop [2]

    jmp pin acquisition

    nop [2]

bit_loop:
    jmp pin first_high

first_low:
    in pins, 1
    nop [1]
    jmp pin bit_ok
    jmp acquisition

first_high:
    in pins, 1
    nop [1]
    jmp pin acquisition

bit_ok:
    jmp x-- bit_loop [2]

    push block

    irq 0

    jmp acquisition


; SM2: RT -> BC
; Esperar COMMAND y STATUS.

public data_rt_to_bc_entry:

    wait 1 irq 0


; SM1: BC -> RT
; Esperar solamente COMMAND.

public data_bc_to_rt_entry:

    wait 1 irq 0

    wait 1 pin 0

    jmp sync_high_begin

.wrap
