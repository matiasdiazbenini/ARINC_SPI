.program mil1553_rx

; ============================================================
; MIL-STD-1553 RX
;
; SM0:
;   pin 0 = GP2 / P
;   Y = 0
;   -> CMD / STATUS
;
; SM1:
;   pin 0 = GP3 / N
;   Y = 1
;   -> DATA WORD
;
; PIO = 8 MHz
; 1 ciclo = 125 ns
;
; Primero:
;   valida SYNC HIGH -> LOW
;
; Luego:
;   valida solamente el PRIMER bit Manchester.
;
; Manchester sobre P:
;
;   bit 1 -> HIGH / LOW
;   bit 0 -> LOW  / HIGH
;
; Como SM1 observa N, que es complementaria,
; se utiliza Y para invertir la interpretación.
; ============================================================

.wrap_target


wait_start:

    ; Partir desde LOW.
    wait 0 pin 0

    ; X=5 queda preparado por si tenemos que
    ; descartar la palabra.
    set x, 5

    ; Esperar comienzo del candidato.
    wait 1 pin 0


    ; ========================================================
    ; VALIDACIÓN DEL SYNC
    ;
    ; Muestra 1: aproximadamente 0.75 us
    ; debe seguir HIGH.
    ; ========================================================

    nop [4]

    jmp pin sync_high_ok

    jmp dead_loop


sync_high_ok:

    ; ========================================================
    ; Muestra 2: aproximadamente 1.75 us
    ; ya debe estar LOW.
    ; ========================================================

    nop [6]

    jmp pin dead_loop


    ; ========================================================
    ; Muestra 3: aproximadamente 2.25 us
    ; debe continuar LOW.
    ; ========================================================

    nop [2]

    jmp pin dead_loop


    ; ========================================================
    ; Muestra 4: aproximadamente 2.75 us
    ; debe continuar LOW.
    ; ========================================================

    nop [2]

    jmp pin dead_loop


    ; ========================================================
    ; PRIMER BIT MANCHESTER
    ;
    ; El SYNC termina en aproximadamente 3 us.
    ;
    ; Esperamos hacia el centro de la primera mitad
    ; del primer bit.
    ; ========================================================

    nop [2]

    ; HIGH en primera mitad.
    jmp pin first_half_high


    ; ========================================================
    ; PRIMERA MITAD = LOW
    ;
    ; Esperar 0.5 us hasta la segunda mitad.
    ; ========================================================

    nop [2]

    ; Segunda mitad debe ser HIGH.
    jmp pin low_high_valid

    ; LOW / LOW -> Manchester inválido.
    jmp dead_loop


low_high_valid:

    ; Tenemos LOW -> HIGH.
    ;
    ; Sobre P  (Y=0): bit 0
    ; Sobre N  (Y=1): bit 1

    jmp !y bit_zero

    jmp bit_one



first_half_high:

    ; ========================================================
    ; PRIMERA MITAD = HIGH
    ;
    ; Esperar 0.5 us hasta la segunda mitad.
    ; ========================================================

    nop [2]

    ; Si sigue HIGH:
    ; HIGH / HIGH -> Manchester inválido.
    jmp pin dead_loop


    ; Tenemos HIGH -> LOW.
    ;
    ; Sobre P  (Y=0): bit 1
    ; Sobre N  (Y=1): bit 0

    jmp !y bit_one

    jmp bit_zero



; ============================================================
; BIT DECODIFICADO
; ============================================================

bit_zero:

    set x, 0
    jmp emit_bit


bit_one:

    set x, 1


emit_bit:

    ; FIFO recibe únicamente:
    ;
    ; 0 -> primer bit = 0
    ; 1 -> primer bit = 1
    ;
    ; El tipo CMD/DATA lo sabemos por la SM.

    mov isr, x
    push block


    ; --------------------------------------------------------
    ; Tiempo muerto TEMPORAL.
    ;
    ; Todavía no recibimos el resto de la palabra.
    ; --------------------------------------------------------

    set x, 5


dead_loop:

    nop [31]
    jmp x-- dead_loop

    jmp wait_start


.wrap