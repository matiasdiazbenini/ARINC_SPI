.program mil1553_rx

; ============================================================
; MIL-STD-1553 RX - DIAGNOSTICO 16 BITS
;
; SM0 -> GP2 / P
; SM1 -> GP3 / N
;
; PIO = 8 MHz
;
; OBJETIVO:
;
; Si ocurre un error Manchester:
;
;       FIFO <- X
;
; X indica cuantos bits quedaban:
;
;       X=15 -> error en bit 1
;       X=14 -> error en bit 2
;       ...
;       X=0  -> error en bit 16
;
; Si se reciben los 16 bits correctamente:
;
;       FIFO <- palabra RAW
;
; IMPORTANTE:
; en esta versión de diagnóstico NO se invierte DATA.
; ============================================================

.wrap_target


; ============================================================
; ESPERAR SINCRONISMO
; ============================================================

wait_start:

    wait 0 pin 0

    mov isr, null

    set x, 15

    wait 1 pin 0



; ============================================================
; VALIDAR SYNC
; ============================================================

    nop [4]

    jmp pin sync_high_ok

    jmp false_word


sync_high_ok:

    nop [6]

    jmp pin false_word


    nop [2]

    jmp pin false_word


    nop [2]

    jmp pin false_word



; ============================================================
; ALINEAR PRIMER BIT
;
; Volvemos a NOP [2], que es la alineación con la cual
; ya habíamos validado correctamente el primer bit.
; ============================================================

    nop [2]



; ============================================================
; RECIBIR BIT
; ============================================================

bit_loop:

    ; Primera mitad.
    jmp pin raw_high



; ============================================================
; LOW -> HIGH
; ============================================================

raw_low:

    ; Guardar LOW.
    in pins, 1

    ; Llegar a segunda mitad.
    nop [1]

    ; Debe ser HIGH.
    jmp pin bit_done

    ; LOW -> LOW = error Manchester.
    jmp manchester_error



; ============================================================
; HIGH -> LOW
; ============================================================

raw_high:

    ; Guardar HIGH.
    in pins, 1

    ; Llegar a segunda mitad.
    nop [1]

    ; Si continúa HIGH:
    ; HIGH -> HIGH = error Manchester.
    jmp pin manchester_error

    ; Si está LOW, bit válido.



; ============================================================
; BIT CORRECTO
; ============================================================

bit_done:

    ; 8 ciclos totales por bit.
    jmp x-- bit_loop [2]



; ============================================================
; LOS 16 BITS LLEGARON CORRECTAMENTE
;
; Se entrega la palabra RAW.
;
; Para CMD/P sería la palabra normal.
;
; Para DATA/N será complementaria.
; Ejemplo:
;
;       TX DATA = 0x1CE3
;
;       RAW N = 0xE31C
; ============================================================

    push block

    set x, 5



dead_loop:

    jmp x-- dead_loop [31]

    jmp wait_start



; ============================================================
; ERROR MANCHESTER
;
; Mandamos X a la FIFO antes de descartar.
; ============================================================

manchester_error:

    mov isr, x

    push block

    jmp false_word



; ============================================================
; DESCARTAR PALABRA
; ============================================================

false_word:

    set x, 5

    jmp dead_loop


.wrap