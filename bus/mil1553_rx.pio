.program mil1553_rx

; ============================================================
; MIL-STD-1553 RX - 16 bits
;
; SM0:
;   pin observado = GP2 / P
;   Y = 0
;   -> CMD / STATUS
;
; SM1:
;   pin observado = GP3 / N
;   Y = 1
;   -> DATA WORD
;
; PIO = 8 MHz
; 1 ciclo = 125 ns
;
; Esta etapa:
;
;   - valida SYNC
;   - recibe 16 bits
;   - valida Manchester
;   - construye la palabra en ISR
;   - NO recibe todavía la paridad
;
; Manchester sobre P:
;
;   bit 1 -> HIGH / LOW
;   bit 0 -> LOW  / HIGH
;
; Sobre N la polaridad es inversa.
; ============================================================

.wrap_target


; ============================================================
; BUSCAR SINCRONISMO
; ============================================================

wait_start:

    ; Esperar línea propia en LOW.
    wait 0 pin 0


    ; --------------------------------------------------------
    ; Preparar recepción ANTES del comienzo del sync.
    ;
    ; Esto es importante:
    ; no agregamos ciclos entre el final del sync y
    ; el primer bit Manchester.
    ; --------------------------------------------------------

    mov isr, null

    ; X=15 -> 16 bits.
    set x, 15


    ; Esperar comienzo del candidato.
    wait 1 pin 0



; ============================================================
; VALIDAR SINCRONISMO
; ============================================================

    ; Primera muestra:
    ; aproximadamente dentro de la primera mitad.
    ; Debe seguir HIGH.

    nop [4]

    jmp pin sync_high_ok

    jmp false_word



sync_high_ok:

    ; Segunda muestra:
    ; ya debe estar LOW.

    nop [6]

    jmp pin false_word


    ; Tercera muestra:
    ; debe continuar LOW.

    nop [2]

    jmp pin false_word


    ; Cuarta muestra:
    ; debe continuar LOW.

    nop [2]

    jmp pin false_word



; ============================================================
; ALINEACIÓN CON EL PRIMER BIT
;
; MISMA alineación temporal que utilizamos en la versión
; donde decodificábamos correctamente un solo bit.
; ============================================================

    nop [2]



; ============================================================
; RECIBIR 16 BITS
;
; Cada iteración válida dura:
;
;       8 ciclos PIO
;
;       8 x 125 ns = 1 us
;
; Por lo tanto no acumulamos desplazamiento temporal.
; ============================================================

bit_loop:

    ; --------------------------------------------------------
    ; Muestra de la primera mitad.
    ;
    ; HIGH -> raw_high
    ; LOW  -> raw_low
    ; --------------------------------------------------------

    jmp pin raw_high



; ============================================================
; PRIMERA MITAD LOW
;
; Manchester válido:
;
;       LOW -> HIGH
; ============================================================

raw_low:

    ; Guardar el nivel de la primera mitad.
    ;
    ; Acá será 0.
    in pins, 1


    ; Dos ciclos.
    ;
    ; Sumados a las instrucciones anteriores nos
    ; posicionamos aproximadamente 500 ns después.
    nop [1]


    ; Segunda mitad:
    ;
    ; debe ser HIGH.
    jmp pin bit_done


    ; LOW -> LOW
    ;
    ; inválido.
    jmp false_word



; ============================================================
; PRIMERA MITAD HIGH
;
; Manchester válido:
;
;       HIGH -> LOW
; ============================================================

raw_high:

    ; Guardar primera mitad.
    ;
    ; Acá será 1.
    in pins, 1


    ; Esperar hacia segunda mitad.
    nop [1]


    ; Si sigue HIGH:
    ;
    ; HIGH -> HIGH
    ;
    ; inválido.
    jmp pin false_word


    ; Si quedó LOW, caemos directamente a bit_done.



; ============================================================
; BIT MANCHESTER VÁLIDO
;
; Camino LOW->HIGH:
;
;   JMP PIN          1
;   IN               1
;   NOP [1]          2
;   JMP PIN          1
;   JMP X-- [2]      3
;                   ---
;                     8 ciclos
;
; Camino HIGH->LOW:
;
;   exactamente lo mismo.
; ============================================================

bit_done:

    jmp x-- bit_loop [2]



; ============================================================
; 16 BITS RECIBIDOS
;
; Para SM0/P:
;
;       ISR = palabra real
;
; Para SM1/N:
;
;       ISR = palabra invertida
;
; Y:
;
;       0 = CMD/STATUS
;       1 = DATA
; ============================================================

    ; SM0 / CMD:
    ; no invertir.
    jmp !y emit_word


    ; SM1 / DATA:
    ; invertir para recuperar el valor lógico.
    mov isr, !isr



; ============================================================
; ENTREGAR PALABRA
; ============================================================

emit_word:

    push block


    ; --------------------------------------------------------
    ; Tiempo muerto temporal.
    ;
    ; Todavía no capturamos la paridad.
    ; --------------------------------------------------------

    set x, 5



dead_loop:

    jmp x-- dead_loop [31]

    jmp wait_start



; ============================================================
; ERROR
;
; Sync inválido o Manchester inválido.
;
; Se descarta el resto de la palabra.
; ============================================================

false_word:

    set x, 5

    jmp dead_loop


.wrap