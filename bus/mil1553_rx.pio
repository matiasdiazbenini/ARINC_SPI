.program mil1553_rx

.wrap_target

acquisition:
    wait 0 pin 0

tracking:
    wait 1 pin 0

    set y, 2

sync_high_check:
    jmp pin sync_high_still
    jmp acquisition

sync_high_still:
    jmp y-- sync_high_check [1]

    wait 0 pin 0

    set x, 16 [3]
    jmp pin acquisition
    nop [2]
    jmp pin acquisition
    nop [2]

bit_loop:
    jmp pin first_high

first_low:
    in pins, 1
    nop [1]
    jmp pin bit_ok
    jmp acquisition

first_high:
    in pins, 1
    nop [1]
    jmp acquisition

bit_ok:
    jmp x-- bit_loop [2]

    push block
    jmp acquisition

.wrap