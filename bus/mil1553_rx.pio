.program mil1553_rx

; ============================================================
; Detector de sincronismo MIL-STD-1553
;
; Mismo programa para dos State Machines:
;
; SM0:
;   IN base  = GP2 / P
;   JMP PIN  = GP2 / P
;   FIFO     -> CMD/STATUS
;
; SM1:
;   IN base  = GP3 / N
;   JMP PIN  = GP3 / N
;   FIFO     -> DATA WORD
;
; Un sincronismo válido, visto sobre la línea que comienza
; activa, tiene:
;
;       HIGH ~1.5 us
;       LOW  ~1.5 us
;
; PIO = 8 MHz
; 1 ciclo = 125 ns
;
; La segunda mitad se comprueba varias veces.
; Esto permite rechazar el flanco de mitad de sync de la
; otra polaridad, porque después de él comienza Manchester.
; ============================================================

.wrap_target


wait_start:

    ; Partir desde LOW.
    wait 0 pin 0

    ; Esperar comienzo del candidato.
    wait 1 pin 0


    ; ========================================================
    ; MUESTRA 1
    ;
    ; Aproximadamente 0.75 us.
    ;
    ; Debe seguir HIGH.
    ; ========================================================

    nop [4]

    jmp pin first_high_ok

    jmp false_sync


first_high_ok:

    ; ========================================================
    ; MUESTRA 2
    ;
    ; Aproximadamente 1.75 us.
    ;
    ; Ya debe estar LOW.
    ; ========================================================

    nop [6]

    ; HIGH -> inválido.
    jmp pin false_sync


    ; ========================================================
    ; MUESTRA 3
    ;
    ; Aproximadamente 2.25 us.
    ;
    ; Debe continuar LOW.
    ;
    ; IMPORTANTE:
    ; si este candidato era en realidad el flanco central
    ; del sync contrario, las muestras de 1.75 y 2.25 us
    ; caen en mitades opuestas de un bit Manchester.
    ; ========================================================

    nop [2]

    jmp pin false_sync


    ; ========================================================
    ; MUESTRA 4
    ;
    ; Aproximadamente 2.75 us.
    ;
    ; Todavía debe seguir LOW.
    ; ========================================================

    nop [2]

    jmp pin false_sync


    ; ========================================================
    ; Sincronismo válido
    ;
    ; Ambas SM escriben 1.
    ;
    ; El Cortex identifica el tipo por la FIFO:
    ;
    ; SM0 -> CMD/STATUS
    ; SM1 -> DATA
    ; ========================================================

    set x, 1
    mov isr, x
    push block

    jmp dead_time



; ============================================================
; CANDIDATO INVÁLIDO
;
; No seguimos buscando dentro de la misma palabra.
; ============================================================

false_sync:

    jmp dead_time



; ============================================================
; TIEMPO MUERTO TEMPORAL
;
; ~25 us para ignorar el resto de la palabra.
; ============================================================

dead_time:

    set y, 5

dead_loop:

    nop [31]
    jmp y-- dead_loop

    jmp wait_start


.wrap