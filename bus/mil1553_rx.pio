.program mil1553_rx

.wrap_target

wait_start:

    ; Para esta prueba:
    ; pin 0 = GP2 / P

    wait 0 pin 0
    wait 1 pin 0


    ; Primera muestra:
    ; P debe continuar HIGH.

    nop [4]

    jmp pin first_ok
    jmp false_sync


first_ok:

    ; Segunda muestra:
    ; P ya debe estar LOW.

    nop [10]

    jmp pin false_sync


    ; Tercera muestra:
    ; P debe continuar LOW.

    nop [2]

    jmp pin false_sync


    ; CMD/STATUS detectado.

    set x, 1
    mov isr, x
    push block

    jmp dead_time


false_sync:

    jmp dead_time


dead_time:

    set y, 4

dead_loop:

    nop [31]
    jmp y-- dead_loop

    jmp wait_start

.wrap