.program mil1553_rx

; ============================================================================
; MIL-STD-1553 RX
;
; PIO clock = 8 MHz
;
; SM0 -> P -> CMD / STATUS
; SM1 -> N -> DATA
;
; NUEVA ESTRATEGIA:
;
; SM0:
;   trabaja normalmente desde cmd_entry.
;
; SM1:
;   arranca en data_entry y espera IRQ 0.
;
; Cuando SM0 termina una palabra CMD/STATUS:
;
;       PUSH
;       IRQ 0
;
; Para RT -> BC:
;
; Cortex rearma SM1 despues de leer el COMMAND.
; De esta forma SM1 queda esperando la IRQ generada
; al terminar STATUS.
;
; Cuando llega esa IRQ, DATA1 ya esta comenzando.
; Como el Sync DATA observado desde N empieza HIGH,
; SM1 entra directamente en la validacion de HIGH,
; sin exigir LOW -> HIGH nuevamente.
;
; ============================================================================


.wrap_target


; ============================================================================
; ENTRADA SM0
; ============================================================================

public cmd_entry:


; ============================================================================
; ACQUISITION NORMAL
; ============================================================================

acquisition:

    wait 0 pin 0


tracking:

    wait 1 pin 0


; ============================================================================
; VALIDACION PRIMERA MITAD HIGH DEL SYNC
; ============================================================================

sync_high_begin:

    set y, 2


sync_high_check:

    jmp pin sync_high_still

    jmp acquisition


sync_high_still:

    jmp y-- sync_high_check [1]


; ============================================================================
; CENTRO DEL SYNC
; ============================================================================

    wait 0 pin 0


; ============================================================================
; SEGUNDA MITAD LOW DEL SYNC
;
; MISMA TEMPORIZACION DEL PIO ORIGINAL.
; ============================================================================

    set x, 16 [3]


    jmp pin acquisition


    nop [2]


    jmp pin acquisition


    nop [2]


; ============================================================================
; RECEPCION MANCHESTER
; ============================================================================

bit_loop:

    jmp pin first_high


; ============================================================================
; PRIMERA MITAD LOW
; ============================================================================

first_low:

    in pins, 1

    nop [1]


    ; LOW -> HIGH
    ;
    ; Manchester valido.
    jmp pin bit_ok


    ; LOW -> LOW
    ;
    ; Manchester invalido.
    jmp acquisition


; ============================================================================
; PRIMERA MITAD HIGH
; ============================================================================

first_high:

    in pins, 1

    nop [1]


    ; HIGH -> HIGH
    ;
    ; Manchester invalido.
    ;
    ; Si esta LOW cae en bit_ok.
    jmp pin acquisition


; ============================================================================
; BIT VALIDO
; ============================================================================

bit_ok:

    jmp x-- bit_loop [2]


; ============================================================================
; PALABRA COMPLETA
; ============================================================================

    push block


; ============================================================================
; AVISO A SM1
;
; IRQ 0 se utiliza como evento interno PIO.
;
; En SM0:
;   indica que termino un CMD / STATUS.
;
; Como este bloque es compartido, SM1 tambien puede
; establecer IRQ 0 despues de un DATA. Esa IRQ residual
; se limpia explicitamente cuando Cortex rearma SM1.
; ============================================================================

    irq 0


    jmp acquisition


; ============================================================================
; ENTRADA ESPECIAL SM1 / DATA
; ============================================================================
;
; SM1 queda bloqueada aqui hasta que SM0 termina
; la palabra que debe preceder al bloque DATA.
;
; WAIT 1 IRQ 0:
;
;   - espera IRQ 0,
;   - al detectarla la limpia automaticamente.
;
; Luego NO hacemos:
;
;       wait 0
;       wait 1
;
; porque al terminar STATUS, DATA Sync puede haber
; comenzado inmediatamente.
;
; DATA Sync observado desde N comienza HIGH.
;
; Por eso simplemente esperamos/confirmamos HIGH
; y entramos a la validacion original del Sync.
;
; ============================================================================

public data_entry:

    wait 1 irq 0

    wait 1 pin 0

    jmp sync_high_begin


.wrap