.program mil1553_rx

; ============================================================
; DIAGNOSTICO DATA - 16 BITS RAW
;
; SM1 observa N.
;
; TX:
;       DATA 0x1CE3
;
; RAW esperado sobre N:
;       0xE31C
;
; No se usa Y.
; No se invierte ISR.
; ============================================================

.wrap_target


wait_start:

    ; Preparar antes de esperar la palabra.
    mov isr, null

    ; 16 bits: X = 15 ... 0
    ; 16 bits de información + 1 bit de paridad
    ; X=16 -> 17 iteraciones
    set x, 16

    wait 0 pin 0
    wait 1 pin 0


; ============================================================
; VALIDAR SYNC
; ============================================================

    nop [4]

    jmp pin sync_high_ok
    jmp discard


sync_high_ok:

    nop [6]
    jmp pin discard

    nop [2]
    jmp pin discard

    nop [2]
    jmp pin discard


; ============================================================
; ALINEAR PRIMER BIT
; ============================================================

    nop [2]


; ============================================================
; BUCLE DE 16 BITS
;
; Se guarda la PRIMERA mitad observada sobre N.
;
; LOW -> HIGH  válido
; HIGH -> LOW  válido
;
; Cada camino válido:
;
;   JMP PIN       1
;   IN PINS,1     1
;   NOP [1]       2
;   JMP PIN       1
;   JMP X-- [2]   3
;                ---
;                  8 ciclos = 1 us
; ============================================================

bit_loop:

    jmp pin first_high


; ------------------------------------------------------------
; Primera mitad LOW
; ------------------------------------------------------------

first_low:

    in pins, 1

    nop [1]

    ; LOW -> HIGH debe terminar en HIGH.
    jmp pin bit_ok

    jmp discard


; ------------------------------------------------------------
; Primera mitad HIGH
; ------------------------------------------------------------

first_high:

    in pins, 1

    nop [1]

    ; HIGH -> LOW:
    ; si sigue HIGH es inválido.
    jmp pin discard

    ; Si está LOW cae a bit_ok.


; ============================================================
; BIT CORRECTO
; ============================================================

bit_ok:

    jmp x-- bit_loop [2]


; ============================================================
; NORMALIZAR POLARIDAD
;
; Y = 0 -> SM0 / P -> CMD/STATUS
;         ya contiene la palabra lógica correcta
;
; Y = 1 -> SM1 / N -> DATA
;         contiene la palabra complementada
; ============================================================

    jmp !y emit_word

    ; Solo DATA necesita inversión.
    mov isr, !isr


emit_word:

    push block


; ============================================================
; IGNORAR RESTO DE PALABRA
; ============================================================

discard:

    set x, 5


dead_loop:

    jmp x-- dead_loop [31]

    jmp wait_start


.wrap