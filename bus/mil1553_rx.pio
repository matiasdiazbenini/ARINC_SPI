.program mil1553_rx

; ============================================================
; Detector de sincronismo CMD/STATUS y DATA WORD
;
; Reloj PIO = 8 MHz
; 1 ciclo   = 125 ns
;
; IN base = GP2
;
; bit 0 = GP2 = P
; bit 1 = GP3 = N
;
; Valores leídos mediante MOV X, PINS:
;
;   0 = 00 -> reposo
;   1 = 01 -> P=1, N=0 -> nivel H
;   2 = 10 -> P=0, N=1 -> nivel L
;   3 = 11 -> estado inválido
;
; Eventos enviados a RX FIFO:
;
;   1 -> SYNC CMD/STATUS detectado
;   2 -> SYNC DATA WORD detectado
;
; NOTA:
; Esta versión solamente detecta y clasifica sincronismos.
; Todavía no decodifica los bits Manchester.
; ============================================================


.wrap_target


; ============================================================
; ESPERAR ACTIVIDAD
; ============================================================

wait_activity:

    ; Leer simultáneamente P y N.
    mov x, pins

    ; 00 = bus en reposo.
    jmp !x wait_activity


    ; --------------------------------------------------------
    ; Descartar 11.
    ;
    ; Los únicos estados activos válidos para nuestro
    ; prototipo diferencial son:
    ;
    ;   01 -> P=1, N=0
    ;   10 -> P=0, N=1
    ; --------------------------------------------------------

    set y, 3
    jmp x!=y classify

    ; X = 3 -> 11 -> inválido.
    jmp false_sync


classify:

    ; --------------------------------------------------------
    ; JMP PIN observa GP2/P.
    ;
    ; P = 1 -> CMD/STATUS
    ; P = 0 -> DATA WORD
    ;
    ; Como ya sabemos que X != 0 y X != 3:
    ;
    ; P=1 implica P/N = 10
    ; P=0 implica P/N = 01
    ; --------------------------------------------------------

    jmp pin cmd_candidate


; ============================================================
; CANDIDATO DATA WORD
;
; DATA:
;
; primera mitad : P=0, N=1
; segunda mitad : P=1, N=0
;
; Sobre P:
;
;      LOW  -> HIGH
;
; Primera muestra  : ~1.0 us
; Segunda muestra  : ~2.0 us
; Tercera muestra  : ~2.625 us
; ============================================================

data_candidate:

    ; ------------------------------------
    ; Primera muestra:
    ; P todavía debe estar LOW.
    ; ------------------------------------

    nop [2]

    ; Si P=1 demasiado pronto -> error.
    jmp pin false_sync


    ; ------------------------------------
    ; Segunda muestra:
    ; P ya debe estar HIGH.
    ; ------------------------------------

    nop [6]

    jmp pin data_high_ok

    ; Sigue LOW -> error.
    jmp false_sync


data_high_ok:

    ; ------------------------------------
    ; Tercera muestra:
    ; P debe continuar HIGH.
    ; ------------------------------------

    nop [3]

    jmp pin data_detected

    ; Volvió a LOW demasiado pronto.
    jmp false_sync


data_detected:

    ; Evento 2 = DATA WORD.
    set x, 2

    ; DATA necesita saltar al bloque común.
    jmp emit_event



; ============================================================
; CANDIDATO CMD / STATUS
;
; CMD/STATUS:
;
; primera mitad : P=1, N=0
; segunda mitad : P=0, N=1
;
; Sobre P:
;
;      HIGH -> LOW
;
; Primera muestra  : ~1.0 us
; Segunda muestra  : ~2.0 us
; Tercera muestra  : ~2.625 us
; ============================================================

cmd_candidate:

    ; ------------------------------------
    ; Primera muestra:
    ; P todavía debe estar HIGH.
    ; ------------------------------------

    nop [2]

    jmp pin cmd_high_ok

    ; Ya está LOW -> error.
    jmp false_sync


cmd_high_ok:

    ; ------------------------------------
    ; Segunda muestra:
    ; P ya debe estar LOW.
    ; ------------------------------------

    nop [6]

    ; Si todavía está HIGH -> error.
    jmp pin false_sync


    ; ------------------------------------
    ; Tercera muestra:
    ; P debe continuar LOW.
    ; ------------------------------------

    nop [3]

    ; Si volvió a HIGH -> error.
    jmp pin false_sync


    ; Evento 1 = CMD/STATUS.
    set x, 1



; ============================================================
; BLOQUE COMÚN DE ENTREGA
;
; X contiene:
;
;   1 -> CMD/STATUS
;   2 -> DATA WORD
; ============================================================

emit_event:

    mov isr, x
    push block



; ============================================================
; TIEMPO MUERTO TEMPORAL
;
; No queremos que los bits Manchester de la misma palabra
; sean interpretados como nuevos sincronismos.
;
; En lugar de usar cinco NOP distintos, usamos un bucle.
;
; Y = 4 produce cinco pasadas por el bucle.
;
; Cada pasada:
;
;   nop [31]       = 32 ciclos
;   jmp y--        = 1 ciclo
;
; Aproximadamente:
;
;   5 x 33 ciclos = 165 ciclos
;   165 x 125 ns  = 20.625 us
;
; Este tiempo muerto desaparecerá cuando implementemos
; la recepción completa de la palabra.
; ============================================================

    set y, 4

dead_time:

    nop [31]
    jmp y-- dead_time

    jmp wait_activity



; ============================================================
; SINCRONISMO INVÁLIDO
; ============================================================

false_sync:

    jmp wait_activity


.wrap