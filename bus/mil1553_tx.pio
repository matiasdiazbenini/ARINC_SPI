.program mil1553_tx

; ============================================================================
; MIL-STD-1553 TX - Raspberry Pi Pico 2 / RP2350
; ============================================================================
;
; PIO clock previsto: 8 MHz
;
;   1 ciclo PIO = 125 ns
;   medio bit   = 4 ciclos = 500 ns
;   bit         = 8 ciclos = 1 us
;
; Salidas diferenciales:
;
;   side 0 -> P=0 N=0  IDLE
;   side 1 -> P=1 N=0  HIGH
;   side 2 -> P=0 N=1  LOW
;
; ============================================================================


.side_set 2 opt


.wrap_target


entry:

    ; ------------------------------------------------------------
    ; Esperar nueva palabra.
    ; ------------------------------------------------------------

    pull block              side 0


    ; ------------------------------------------------------------
    ; Selector SYNC:
    ;
    ; 1 = Command / Status
    ; 0 = Data
    ; ------------------------------------------------------------

    out x, 1                side 0


    ; ------------------------------------------------------------
    ; 16 bits + parity
    ; ------------------------------------------------------------

    set y, 16               side 0


    ; ------------------------------------------------------------
    ; Seleccionar tipo de sincronismo.
    ; ------------------------------------------------------------

    jmp !x data_prepare     side 0


; ============================================================================
; COMMAND / STATUS
; ============================================================================

cmd_prepare:

    ; Precargar primer bit.

    out x, 1                side 0


    ; Habilitar P y N como salidas.

    set pindirs, 3          side 0


    ; ------------------------------------------------------------
    ; SYNC COMMAND / STATUS
    ;
    ; HIGH 1.5 us
    ; ------------------------------------------------------------

    nop                     side 1 [3]
    nop                     side 1 [3]
    nop                     side 1 [3]


    ; ------------------------------------------------------------
    ; LOW 1.5 us
    ; ------------------------------------------------------------

    nop                     side 2 [3]
    nop                     side 2 [3]

    jmp sync_decide         side 2 [1]


; ============================================================================
; DATA
; ============================================================================

data_prepare:

    ; Precargar primer bit.

    out x, 1                side 0


    ; Habilitar P y N como salidas.

    set pindirs, 3          side 0


    ; ------------------------------------------------------------
    ; SYNC DATA
    ;
    ; LOW 1.5 us
    ; ------------------------------------------------------------

    nop                     side 2 [3]
    nop                     side 2 [3]
    nop                     side 2 [3]


    ; ------------------------------------------------------------
    ; HIGH 1.5 us
    ; ------------------------------------------------------------

    nop                     side 1 [3]
    nop                     side 1 [3]

    jmp sync_decide         side 1 [1]


; ============================================================================
; FINAL DEL SYNC
; ============================================================================

sync_decide:

    jmp !x sync_zero

    jmp one_bit


sync_zero:

    jmp zero_bit


; ============================================================================
; CARGAR SIGUIENTE BIT
; ============================================================================

more_bits:

    out x, 1

    jmp !x zero_bit [1]


; ============================================================================
; MANCHESTER BIT = 1
;
; HIGH / LOW
; ============================================================================

one_bit:

    nop                     side 1 [3]


    jmp y-- more_bits       side 2


    jmp end_word                   [2]


; ============================================================================
; MANCHESTER BIT = 0
;
; LOW / HIGH
; ============================================================================

zero_bit:

    nop                     side 2 [3]


    jmp y-- more_bits       side 1


    jmp end_word                   [2]


; ============================================================================
; FIN DE PALABRA
; ============================================================================

end_word:

    ; ------------------------------------------------------------
    ; Finalizo exactamente la ultima mitad del bit
    ; de paridad.
    ;
    ; side 0:
    ;
    ;      P = 0
    ;      N = 0
    ;
    ; pindirs = 0:
    ;
    ;      GP2 entrada
    ;      GP3 entrada
    ;
    ; El transmisor libera el bus.
    ; ------------------------------------------------------------

    set pindirs, 0          side 0


.wrap