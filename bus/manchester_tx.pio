.program manchester_tx

.wrap_target
next_bit:
    out x, 1
    jmp !x bit_zero

bit_one:
    set pins, 1 [15]
    set y, 31
delay_one_a:
    jmp y-- delay_one_a

    set pins, 2 [15]
    set y, 31
delay_one_b:
    jmp y-- delay_one_b

    jmp next_bit

bit_zero:
    set pins, 2 [15]
    set y, 31
delay_zero_a:
    jmp y-- delay_zero_a

    set pins, 1 [15]
    set y, 31
delay_zero_b:
    jmp y-- delay_zero_b

    jmp next_bit

.wrap