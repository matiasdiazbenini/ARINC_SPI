.program manchester_tx

.side_set 2 opt

; TX Manchester por BYTE.
; side 1 = 01 = P=1,N=0 = H
; side 2 = 10 = P=0,N=1 = L
;
; bit 1 = H -> L
; bit 0 = L -> H

.wrap_target
    pull block
    set y, 7

bitloop:
    out x, 1
    jmp !x bit_zero

bit_one:
    nop side 1 [3]
    nop side 1 [3]
    nop side 2 [3]
    nop side 2 [3]
    jmp next_bit

bit_zero:
    nop side 2 [3]
    nop side 2 [3]
    nop side 1 [3]
    nop side 1 [3]
    jmp next_bit

next_bit:
    jmp y-- bitloop

.wrap