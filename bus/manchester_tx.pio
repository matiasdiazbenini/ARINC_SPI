.program manchester_tx

; Cada bit:
; 2 mitades con delay controlado

.wrap_target
next_bit:
    out x, 1
    jmp !x bit_zero

bit_one:
    ; HIGH
    set pins, 1 [15]
    ; LOW
    set pins, 2 [15]
    jmp next_bit

bit_zero:
    ; LOW
    set pins, 2 [15]
    ; HIGH
    set pins, 1 [15]
    jmp next_bit

.wrap