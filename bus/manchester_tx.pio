.program manchester_tx
; Manchester TX sobre 2 pines (P,N) -> GP2/GP3.
; Convencion:
;   bit 1: P=1,N=0 -> P=0,N=1
;   bit 0: P=0,N=1 -> P=1,N=0
;
; Este paso es de integracion inicial: solo agrega el programa PIO.
; La temporizacion final y el uso desde C se conectaran en pasos siguientes.
;
; El programa consume 1 bit por iteracion usando OUT X, 1.
; Para MSB-first, configurar el SM en C con shift adecuado al empuje de datos.

.wrap_target
next_bit:
    out x, 1
    jmp !x bit_zero

bit_one:
    set pins, 1
    set pins, 2
    jmp next_bit

bit_zero:
    set pins, 2
    set pins, 1
    jmp next_bit

.wrap
