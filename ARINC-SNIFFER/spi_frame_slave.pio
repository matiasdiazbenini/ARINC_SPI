.program spi_frame_rx32

.wrap_target
wait_frame:
    wait 0 gpio 17
    set y, 7

word_loop:
    set x, 31

bit_loop:
    wait 1 gpio 18
    in pins, 1
    wait 0 gpio 18
    jmp x-- bit_loop

    push block
    jmp y-- word_loop
    wait 1 gpio 17
.wrap


.program spi_frame_tx32

.wrap_target
wait_frame:
    wait 0 gpio 17
    set y, 7

word_loop:
    pull block
    set x, 31

bit_loop:
    out pins, 1
    wait 1 gpio 18
    wait 0 gpio 18
    jmp x-- bit_loop

    jmp y-- word_loop
    set pins, 0
    wait 1 gpio 17
.wrap
