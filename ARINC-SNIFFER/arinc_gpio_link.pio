.program arinc_gpio_link_tx

.define public HALF_CYCLES 5
.define public WORD_GAP_HALVES 8

; Archivo compartido con los otros nodos.
; El mismo bloque se instancia sobre el canal directo o el reverso
; configurando "pin_base" y "pin_base + 1" desde C.
; En el sniffer solo se usa la parte RX, pero se conserva completo para
; mantener el mismo contrato PIO entre los tres firmwares.

.wrap_target
word_start:
    pull block
    set y, 31

bitloop:
    out x, 1
    jmp !x send_zero

send_one:
    set pins, 2        [HALF_CYCLES - 1]
    set pins, 0        [HALF_CYCLES - 1]
    jmp bit_done

send_zero:
    set pins, 1        [HALF_CYCLES - 1]
    set pins, 0        [HALF_CYCLES - 1]

bit_done:
    jmp y-- bitloop

gap_setup:
    set x, 7

gap_loop:
    set pins, 0        [HALF_CYCLES - 1]
    jmp x-- gap_loop
.wrap


.program arinc_gpio_link_rx

; RX por PIO:
; 1. Espera actividad solo en el par configurado.
; 2. Clasifica el bit usando "pin_base + 1" como bit logico.
; 3. Espera el retorno a idle 00 para marcar el fin del simbolo.
; 4. Repite 32 veces y empuja la palabra completa a la FIFO RX.
;
; La PIO no filtra. El filtrado se hace despues, en C, con la palabra ya
; reconstruida para poder inspeccionar label, SDI, payload y paridad.
;
; En el sniffer necesitamos que cada RX mire exclusivamente su propio par
; (FWD o REV). Por eso el muestreo de actividad/idle se hace con "in pins, 2"
; preservando el ISR en OSR, en lugar de usar "mov ..., pins" sobre todo el
; banco GPIO del PIO.

.wrap_target
word_start:
    mov isr, null
    set x, 31

wait_active:
    mov osr, isr
    mov isr, null
    in pins, 2
    mov y, isr
    mov isr, osr
    jmp !y wait_active
    jmp pin bit_one

bit_zero:
    set y, 0
    in y, 1
    jmp wait_idle

bit_one:
    set y, 1
    in y, 1

wait_idle:
    mov osr, isr
    mov isr, null
    in pins, 2
    mov y, isr
    mov isr, osr
    jmp !y bit_done
    jmp wait_idle

bit_done:
    jmp x-- wait_active
    push block
.wrap
